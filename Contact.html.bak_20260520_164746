<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>Contact — Serenzer</title>
<meta name="description" content="Contactez Serenzer. Une question, une suggestion ou une demande ? Écrivez-nous.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
:root {
  --lin-calme: #F8F6F2;
  --encre-douce: #2F3A3F;
  --argile-clair: #EFE9DF;
  --pierre-pale: #D9D4CC;
  --cendre-tiede: #4E4A46;
  --sauge-douce: #8FA89B;
  --sauge-deep: #7A9587;
  --sauge-light: rgba(143, 168, 155, 0.15);
  --text-muted: #9A958F;

  --font-display: 'Fraunces', Georgia, serif;
  --font-body: 'Inter', -apple-system, sans-serif;

  --max-width: 800px;
  --space-xs: 0.5rem;
  --space-sm: 1rem;
  --space-md: 1.5rem;
  --space-lg: 3rem;
  --space-xl: 5rem;
}

*, *::before, *::after { margin: 0; padding: 0; box-sizing: border-box; }

html { scroll-behavior: smooth; font-size: 16px; }

body {
  font-family: var(--font-body);
  color: var(--encre-douce);
  background-color: var(--lin-calme);
  line-height: 1.7;
  font-weight: 400;
  -webkit-font-smoothing: antialiased;
  -moz-osx-font-smoothing: grayscale;
}

a { color: var(--sauge-douce); text-decoration: none; transition: color 0.3s ease; }
a:hover { color: var(--sauge-deep); }

.nav {
  position: fixed; top: 0; left: 0; right: 0; z-index: 100;
  padding: var(--space-sm) 0;
  background: rgba(248, 246, 242, 0.92);
  backdrop-filter: blur(20px);
  -webkit-backdrop-filter: blur(20px);
  box-shadow: 0 1px 0 var(--pierre-pale);
}

.nav__inner {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 var(--space-md);
  display: flex; align-items: center; justify-content: space-between;
}

.nav__brand {
  display: flex; align-items: center; gap: 0.5rem;
  font-family: var(--font-display);
  font-size: 1.5rem; font-weight: 500;
  color: var(--encre-douce);
  letter-spacing: -0.02em;
  text-decoration: none;
}

.nav__logo { height: 36px; width: auto; }

.nav__back {
  font-size: 0.9rem; font-weight: 500;
  color: var(--cendre-tiede);
  display: flex; align-items: center; gap: 0.4rem;
  text-decoration: none;
  transition: color 0.3s ease;
}

.nav__back:hover { color: var(--sauge-douce); }

.page {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 120px var(--space-md) var(--space-xl);
}

.page__intro { text-align: center; margin-bottom: var(--space-lg); }

.page__title {
  font-family: var(--font-display);
  font-size: clamp(2rem, 4vw, 2.6rem);
  font-weight: 500;
  color: var(--encre-douce);
  margin-bottom: var(--space-sm);
  line-height: 1.15;
  letter-spacing: -0.015em;
}

.page__subtitle {
  font-size: 1.05rem;
  color: var(--cendre-tiede);
  max-width: 540px;
  margin: 0 auto;
  line-height: 1.6;
}

.contact-card {
  background: white;
  border: 1px solid var(--argile-clair);
  border-radius: 20px;
  padding: clamp(1.5rem, 4vw, 2.5rem);
  box-shadow: 0 1px 3px rgba(47, 58, 63, 0.04);
}

.form__row {
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-md);
  margin-bottom: var(--space-md);
}

.form__field { display: flex; flex-direction: column; }

.form__label {
  font-size: 0.85rem;
  font-weight: 500;
  color: var(--cendre-tiede);
  margin-bottom: 0.4rem;
}

.form__label .req {
  color: var(--sauge-douce);
  margin-left: 2px;
}

.form__input,
.form__textarea {
  width: 100%;
  padding: 0.85rem 1rem;
  background: var(--lin-calme);
  border: 1px solid var(--argile-clair);
  border-radius: 12px;
  font-family: inherit;
  font-size: 0.95rem;
  color: var(--encre-douce);
  transition: border-color 0.2s ease, background 0.2s ease, box-shadow 0.2s ease;
}

.form__input::placeholder,
.form__textarea::placeholder {
  color: var(--text-muted);
}

.form__input:hover,
.form__textarea:hover {
  border-color: var(--pierre-pale);
}

.form__input:focus,
.form__textarea:focus {
  outline: none;
  border-color: var(--sauge-douce);
  background: white;
  box-shadow: 0 0 0 3px var(--sauge-light);
}

.form__textarea {
  min-height: 160px;
  resize: vertical;
  line-height: 1.6;
}

.form__hint {
  font-size: 0.8rem;
  color: var(--text-muted);
  margin-top: 0.4rem;
  line-height: 1.5;
}

.form__actions {
  display: flex; align-items: center; justify-content: space-between;
  gap: var(--space-md);
  margin-top: var(--space-md);
  flex-wrap: wrap;
}

.btn {
  display: inline-flex; align-items: center; justify-content: center;
  gap: 0.5rem;
  padding: 0.9rem 1.6rem;
  background: var(--sauge-douce);
  color: white;
  font-family: inherit;
  font-size: 0.95rem;
  font-weight: 500;
  border: 0;
  border-radius: 14px;
  cursor: pointer;
  transition: background 0.2s ease, transform 0.1s ease;
}

.btn:hover { background: var(--sauge-deep); }
.btn:active { transform: scale(0.98); }
.btn svg { width: 16px; height: 16px; }

.form__legal {
  font-size: 0.8rem;
  color: var(--text-muted);
  line-height: 1.6;
  flex: 1;
}

.contact-aside {
  margin-top: var(--space-lg);
  display: grid;
  grid-template-columns: 1fr;
  gap: var(--space-md);
}

.aside-card {
  background: white;
  border: 1px solid var(--argile-clair);
  border-radius: 16px;
  padding: var(--space-md);
  display: flex; align-items: flex-start; gap: 0.85rem;
}

.aside-card__icon {
  width: 40px; height: 40px;
  flex: none;
  border-radius: 12px;
  background: var(--sauge-light);
  color: var(--sauge-douce);
  display: grid; place-items: center;
}

.aside-card__icon svg { width: 18px; height: 18px; }

.aside-card__title {
  font-family: var(--font-display);
  font-size: 1rem; font-weight: 500;
  margin-bottom: 0.2rem;
  color: var(--encre-douce);
}

.aside-card__desc {
  font-size: 0.85rem;
  color: var(--cendre-tiede);
  line-height: 1.55;
}

.aside-card__desc a { font-weight: 500; }

.footer {
  padding: var(--space-lg) 0 var(--space-md);
  border-top: 1px solid var(--argile-clair);
  margin-top: var(--space-xl);
}

.footer__inner {
  max-width: var(--max-width);
  margin: 0 auto;
  padding: 0 var(--space-md);
  display: flex; align-items: center; justify-content: space-between;
  flex-wrap: wrap; gap: var(--space-sm);
}

.footer__brand {
  font-family: var(--font-display);
  font-size: 1.1rem; font-weight: 500;
  color: var(--encre-douce);
  display: flex; align-items: center; gap: 0.4rem;
}

.footer__brand img { height: 28px; width: auto; }

.footer__tagline {
  font-size: 0.8rem;
  color: var(--pierre-pale);
  margin-top: 0.25rem;
}

.footer__links { display: flex; gap: var(--space-md); }

.footer__link { font-size: 0.85rem; color: var(--cendre-tiede); }
.footer__link:hover { color: var(--sauge-douce); }

.footer__bottom {
  max-width: var(--max-width);
  margin: var(--space-md) auto 0;
  padding: var(--space-sm) var(--space-md) 0;
  border-top: 1px solid var(--argile-clair);
  text-align: center;
}

.footer__copy { font-size: 0.8rem; color: var(--pierre-pale); }

@media (min-width: 640px) {
  .form__row--two { grid-template-columns: 1fr 1fr; }
  .contact-aside { grid-template-columns: 1fr 1fr; }
}

@media (max-width: 600px) {
  .page { padding: 100px var(--space-sm) var(--space-lg); }
  .footer__inner { flex-direction: column; text-align: center; }
}
</style>
</head>
<body>

<nav class="nav">
  <div class="nav__inner">
    <a href="index.html" class="nav__brand">
      <img src="assets/serenzer_wave.png" alt="Serenzer" class="nav__logo"> Serenzer
    </a>
    <a href="index.html" class="nav__back">
      <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M19 12H5M12 19l-7-7 7-7"/></svg>
      Retour au site
    </a>
  </div>
</nav>

<main class="page">

  <div class="page__intro">
    <h1 class="page__title">Contact</h1>
    <p class="page__subtitle">Une question, une suggestion ou une demande particulière&nbsp;? Écrivez-nous, nous vous répondrons rapidement.</p>
  </div>

  <div class="contact-card">
    <form action="send.php" method="POST" novalidate>
      <div class="form__row form__row--two">
        <div class="form__field">
          <label class="form__label" for="prenom">Prénom <span class="req">*</span></label>
          <input class="form__input" type="text" id="prenom" name="prenom" placeholder="Votre prénom" required autocomplete="given-name">
        </div>
        <div class="form__field">
          <label class="form__label" for="email">Email <span class="req">*</span></label>
          <input class="form__input" type="email" id="email" name="email" placeholder="vous@exemple.com" required autocomplete="email">
        </div>
      </div>

      <div class="form__row">
        <div class="form__field">
          <label class="form__label" for="sujet">Sujet <span class="req">*</span></label>
          <input class="form__input" type="text" id="sujet" name="sujet" placeholder="L’objet de votre message" required>
        </div>
      </div>

      <div class="form__row">
        <div class="form__field">
          <label class="form__label" for="message">Message <span class="req">*</span></label>
          <textarea class="form__textarea" id="message" name="message" placeholder="Décrivez votre demande en quelques lignes…" required></textarea>
          <p class="form__hint">Merci de ne pas inclure d’informations sensibles dans votre message.</p>
        </div>
      </div>

      <div class="form__actions">
        <p class="form__legal">En envoyant ce formulaire, vous acceptez que vos informations soient traitées pour répondre à votre demande, conformément à notre <a href="https://apps.serenzer.com/privacy-policy?lang=fr">politique de confidentialité</a>.</p>
        <button class="btn" type="submit">
          Envoyer
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>
        </button>
      </div>
    </form>
  </div>

  <div class="contact-aside">
    <div class="aside-card">
      <div class="aside-card__icon" aria-hidden="true">
        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"><path d="M12 3l8 4v5c0 5-3.5 8-8 9-4.5-1-8-4-8-9V7l8-4z"/><path d="M9 12l2 2 4-4"/></svg>
      </div>
      <div>
        <div class="aside-card__title">Données protégées</div>
        <p class="aside-card__desc">Vos informations sont traitées conformément au RGPD et ne sont jamais revendues.</p>
      </div>
    </div>
  </div>

</main>

<footer class="footer">
  <div class="footer__inner">
    <div>
      <div class="footer__brand">
        <img src="assets/serenzer_wave.png" alt="Serenzer">
        Serenzer
      </div>
      <div class="footer__tagline">Idées, projets, calendrier, suivi</div>
    </div>
    <div class="footer__links">
      <a href="Mentions_legales.html" class="footer__link">Mentions légales</a>
      <a href="index.html" class="footer__link">Accueil</a>
    </div>
  </div>
  <div class="footer__bottom">
    <p class="footer__copy">© 2026 Serenzer Ltd. Tous droits réservés.</p>
  </div>
</footer>

<script>
(function() {
  var p = ['c','o','n','t','a','c','t'];
  var d = ['s','e','r','e','n','z','e','r','.','c','o','m'];
  function buildEmail(parts, domain) {
    return parts.join('') + String.fromCharCode(64) + domain.join('');
  }
  function createLink(addr) {
    var a = document.createElement('a');
    a.href = 'mai' + 'lto:' + addr;
    a.textContent = addr;
    a.style.color = '#8FA89B';
    a.style.fontWeight = '500';
    a.style.textDecoration = 'none';
    return a;
  }
  var el1 = document.getElementById('emailContact');
  if (el1) el1.parentNode.replaceChild(createLink(buildEmail(p, d)), el1);
})();
</script>

</body>
</html>
