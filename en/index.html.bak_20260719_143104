  var browserPref = (navigator.language||'fr').slice(0,2).toLowerCase();
  // Initial language: detected from URL first (so /en/ -> en), fallback to FR (root = x-default).
  var pathMatch = window.location.pathname.match(/^\/(fr|en|de|es|it|nl)(\/|$)/);
  var initial = pathMatch ? pathMatch[1] : 'fr';

  function applyI18n(lang){
    var dict = window.SERENZER_I18N[lang] || window.SERENZER_I18N.fr;
    document.documentElement.setAttribute('lang', lang);

    // text
    document.querySelectorAll('[data-i18n]').forEach(function(el){
      var key = el.getAttribute('data-i18n');
      var val = dict[key];
      if(val == null) return;
      var attr = el.getAttribute('data-i18n-attr');
      if(attr){ el.setAttribute(attr, val); }
      else { el.textContent = val; }
    });

    // html (allows <strong>)
    document.querySelectorAll('[data-i18n-html]').forEach(function(el){
      var key = el.getAttribute('data-i18n-html');
      if(dict[key] != null) el.innerHTML = dict[key];
    });

    // tags arrays
    document.querySelectorAll('[data-i18n-tags]').forEach(function(el){
      var key = el.getAttribute('data-i18n-tags');
      var arr = dict[key];
      if(!Array.isArray(arr)) return;
      el.innerHTML = '';
      arr.forEach(function(t){
        var span = document.createElement('span');
        span.className = 'tag';
        span.textContent = t;
        el.appendChild(span);
      });
    });

    // bullets arrays
    document.querySelectorAll('[data-i18n-bullets]').forEach(function(el){
      var key = el.getAttribute('data-i18n-bullets');
      var arr = dict[key];
      if(!Array.isArray(arr)) return;
      el.innerHTML = '';
      arr.forEach(function(text){
        var li = document.createElement('li');
        var icon = document.createElement('span');
        icon.className = 'feature__check';
        icon.setAttribute('aria-hidden','true');
        icon.innerHTML = '<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
        var span = document.createElement('span');
        span.textContent = text;
        li.appendChild(icon);
        li.appendChild(span);
        el.appendChild(li);
      });
    });

    // current lang label
    var current = LANGS.find(function(l){return l.code===lang;});
    var lbl = document.getElementById('langLabel');
    if(lbl && current) lbl.textContent = current.label;

    // mark active in menu
    document.querySelectorAll('#langMenu .lang-select__item').forEach(function(it){
      if(it.dataset.code === lang) it.classList.add('is-active');
      else it.classList.remove('is-active');
    });
  }

  function setLang(lang){
    try{ localStorage.setItem('serenzer_lang', lang); }catch(e){}
    applyI18n(lang);
  }

  // build language menu
  var menu = document.getElementById('langMenu');
  LANGS.forEach(function(l){
    var li = document.createElement('li');
    var btn = document.createElement('button');
    btn.className = 'lang-select__item';
    btn.setAttribute('role','option');
    btn.dataset.code = l.code;
    btn.innerHTML =
      '<span>'+l.label+'</span>'+
      '<svg class="lang-select__check" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"/></svg>';
    btn.addEventListener('click', function(){
      // Navigate to the language URL instead of in-place i18n. Preserves current page (e.g. /en/Contact.html -> /fr/Contact.html).
      try { localStorage.setItem('serenzer_lang', l.code); } catch(e){}
      var path = window.location.pathname;
      var m = path.match(/^\/(fr|en|de|es|it|nl)(\/.*)?$/);
      var rest = m ? (m[2] || '/') : (path === '/' ? '/' : path);
      var target = ('/' + l.code + rest).replace(/\/+/g, '/');
      if (target !== path) {
        window.location.href = target;
        return;
      }
      document.getElementById('langSelect').classList.remove('is-open');
      document.getElementById('langBtn').setAttribute('aria-expanded','false');
    });
    li.appendChild(btn);
    menu.appendChild(li);
  });

  // toggle menu
  var sel = document.getElementById('langSelect');
  var btn = document.getElementById('langBtn');
  btn.addEventListener('click', function(e){
    e.stopPropagation();
    var isOpen = sel.classList.toggle('is-open');
    btn.setAttribute('aria-expanded', isOpen?'true':'false');
  });
  document.addEventListener('click', function(){
    sel.classList.remove('is-open');
    btn.setAttribute('aria-expanded','false');
  });

  // === Languages grid (multi section) ===
  var ALL_LANGS = ['Français','English','Deutsch','Italiano','Español','Nederlands','Português','Polski','Türkçe','Svenska','Norsk','Dansk','Suomi','Čeština','Magyar','Română','Ελληνικά','日本語','한국어','中文','العربية','हिन्दी'];
  var grid = document.getElementById('langGrid');
  ALL_LANGS.forEach(function(l){
    var s = document.createElement('span');
    s.className = 'lang-chip';
    s.textContent = l;
    grid.appendChild(s);
  });

  // === Nav scrolled ===
  var nav = document.getElementById('nav');
  function onScroll(){
    if(window.scrollY > 8) nav.classList.add('is-scrolled');
    else nav.classList.remove('is-scrolled');
  }
  window.addEventListener('scroll', onScroll, {passive:true});
  onScroll();

  // === Reveal on scroll ===
  if('IntersectionObserver' in window){
    var io = new IntersectionObserver(function(entries){
      entries.forEach(function(en){
        if(en.isIntersecting){
          en.target.classList.add('is-in');
          io.unobserve(en.target);
        }
      });
    },{threshold:.1, rootMargin:'0px 0px -40px 0px'});
    document.querySelectorAll('.reveal').forEach(function(el){ io.observe(el); });
  } else {
    document.querySelectorAll('.reveal').forEach(function(el){ el.classList.add('is-in'); });
  }

  // initial apply
  applyI18n(initial);
})();
</script>
</body>
</html>