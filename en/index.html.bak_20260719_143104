<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title data-i18n="meta_title">Serenzer — Personal AI assistant to organize your ideas and projects</title>
<meta name="description" data-i18n-attr="content" data-i18n="meta_description" content="Serenzer is a personal AI assistant for structuring your ideas, organizing projects, tracking tasks, preparing your calendar and centralizing daily information.">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600&family=Inter:wght@400;500;600&display=swap" rel="stylesheet">
<style>
  :root{
    /* palette */
    --color-lin-calme:#F8F6F2;
    --color-cendre-tiede:#4E4A46;
    --color-argile-clair:#EFE9DF;
    --color-pierre-pale:#D9D4CC;
    --color-sauge-douce:#8FA89B;
    --color-sable-chaud:#D1B38B;
    --color-mousse-legere:#A6C3B3;
    --color-encre-douce:#2F3A3F;

    --color-background:var(--color-lin-calme);
    --color-surface:#FFFFFF;
    --color-text-primary:var(--color-encre-douce);
    --color-text-secondary:var(--color-cendre-tiede);
    --color-text-muted:#9A958F;
    --color-text-light:#B5B0A8;
    --color-accent:var(--color-sauge-douce);
    --color-accent-hover:#7A9587;
    --color-accent-light:rgba(143,168,155,.15);
    --color-border:var(--color-argile-clair);
    --color-border-light:#F0EBE3;
    --color-success:var(--color-sauge-douce);
    --color-warning:var(--color-sable-chaud);

    /* typography */
    --font-display:'Fraunces',Georgia,serif;
    --font-body:'Inter',-apple-system,BlinkMacSystemFont,'Segoe UI',sans-serif;

    --text-xs:11px; --text-sm:13px; --text-base:15px; --text-md:17px;
    --text-lg:20px; --text-xl:24px; --text-2xl:28px;

    /* spacing */
    --space-xs:4px; --space-sm:8px; --space-md:12px; --space-lg:16px;
    --space-xl:20px; --space-2xl:24px; --space-3xl:32px; --space-4xl:40px;
    --space-5xl:48px; --space-6xl:64px; --space-7xl:80px; --space-8xl:96px;

    /* radius */
    --radius-xs:4px; --radius-sm:8px; --radius-md:12px; --radius-lg:16px;
    --radius-xl:20px; --radius-2xl:24px; --radius-full:9999px;

    /* shadow */
    --shadow-sm:0 1px 3px rgba(47,58,63,.04);
    --shadow-md:0 2px 8px rgba(47,58,63,.06);
    --shadow-lg:0 4px 16px rgba(47,58,63,.08);
    --shadow-xl:0 8px 24px rgba(47,58,63,.10);
    --shadow-accent:0 4px 12px rgba(143,168,155,.35);

    /* transition */
    --transition-fast:100ms ease;
    --transition-normal:150ms ease;
    --transition-slow:250ms ease;
  }

  *,*::before,*::after{box-sizing:border-box}
  html,body{margin:0;padding:0}
  body{
    background:var(--color-background);
    color:var(--color-text-primary);
    font-family:var(--font-body);
    font-size:var(--text-base);
    line-height:1.5;
    -webkit-font-smoothing:antialiased;
    -moz-osx-font-smoothing:grayscale;
  }
  a{color:inherit;text-decoration:none}
  ul{margin:0;padding:0;list-style:none}
  button{font-family:inherit;cursor:pointer;border:0;background:none;color:inherit}
  img,svg{display:block;max-width:100%}
  ::selection{background:var(--color-accent-light);color:var(--color-encre-douce)}

  .container{
    width:100%;
    max-width:1200px;
    margin:0 auto;
    padding:0 var(--space-2xl);
  }

  /* === NAV === */
  .nav{
    position:sticky;top:0;z-index:50;
    background:rgba(248,246,242,.85);
    backdrop-filter:blur(12px);
    -webkit-backdrop-filter:blur(12px);
    border-bottom:1px solid transparent;
    transition:border-color var(--transition-normal);
  }
  .nav.is-scrolled{border-bottom-color:var(--color-border-light)}
  .nav__inner{
    height:var(--header-height,68px);
    display:flex;align-items:center;justify-content:space-between;
  }
  .brand{display:flex;align-items:center;gap:var(--space-md)}
  .brand__mark{
    width:40px;height:40px;
    flex:none;
    display:grid;place-items:center;
  }
  .brand__mark img{width:100%;height:100%;object-fit:contain;display:block}
  .brand__mark svg{width:20px;height:20px;color:#fff}
  .brand__name{
    font-family:var(--font-display);
    font-size:var(--text-lg);
    font-weight:500;letter-spacing:-.01em;
    color:var(--color-encre-douce);
  }
  .nav__links{display:none;gap:var(--space-3xl);align-items:center}
  .nav__links a{
    font-size:var(--text-sm);font-weight:500;
    color:var(--color-text-secondary);
    transition:color var(--transition-normal);
  }
  .nav__links a:hover{color:var(--color-text-primary)}
  .nav__right{display:flex;align-items:center;gap:var(--space-md)}
  .lang-select{
    position:relative;
  }
  .lang-select__btn{
    display:inline-flex;align-items:center;gap:var(--space-sm);
    padding:8px 12px;border-radius:var(--radius-md);
    background:transparent;
    color:var(--color-text-secondary);
    font-size:var(--text-sm);font-weight:500;
    transition:background var(--transition-normal);
  }
  .lang-select__btn:hover{background:var(--color-argile-clair)}
  .lang-select__btn svg{width:14px;height:14px}
  .lang-select__menu{
    position:absolute;top:calc(100% + 6px);right:0;
    min-width:160px;
    background:var(--color-surface);
    border:1px solid var(--color-border-light);
    border-radius:var(--radius-md);
    box-shadow:var(--shadow-lg);
    padding:4px;
    opacity:0;visibility:hidden;
    transform:translateY(-4px);
    transition:opacity var(--transition-normal),transform var(--transition-normal),visibility var(--transition-normal);
    z-index:10;
  }
  .lang-select.is-open .lang-select__menu{opacity:1;visibility:visible;transform:translateY(0)}
  .lang-select__item{
    display:flex;align-items:center;justify-content:space-between;
    width:100%;
    padding:10px 12px;border-radius:var(--radius-sm);
    font-size:var(--text-sm);font-weight:500;
    color:var(--color-text-primary);
    text-align:left;
    transition:background var(--transition-fast);
  }
  .lang-select__item:hover{background:var(--color-lin-calme)}
  .lang-select__item.is-active{color:var(--color-accent)}
  .lang-select__check{width:14px;height:14px;opacity:0}
  .lang-select__item.is-active .lang-select__check{opacity:1}

  /* === BUTTONS === */
  .btn{
    display:inline-flex;align-items:center;justify-content:center;gap:var(--space-sm);
    padding:var(--space-md) var(--space-xl);
    font-size:var(--text-base);font-weight:500;
    border-radius:var(--radius-lg);
    transition:background var(--transition-normal),color var(--transition-normal),transform var(--transition-fast);
    white-space:nowrap;
  }
  .btn--primary{background:var(--color-accent);color:#fff}
  .btn--primary:hover{background:var(--color-accent-hover)}
  .btn--secondary{background:var(--color-argile-clair);color:var(--color-text-primary)}
  .btn--secondary:hover{background:var(--color-pierre-pale)}
  .btn--ghost{background:transparent;color:var(--color-text-secondary)}
  .btn--ghost:hover{background:var(--color-argile-clair);color:var(--color-text-primary)}
  .btn--lg{padding:var(--space-lg) var(--space-2xl);font-size:var(--text-md)}
  .btn--sm{padding:var(--space-sm) var(--space-lg);font-size:var(--text-sm)}
  .btn:active{transform:scale(.98)}
  .btn svg{width:16px;height:16px;flex:none}

  /* === HERO === */
  .hero{padding:var(--space-7xl) 0 var(--space-6xl);position:relative;overflow:hidden}
  .hero__grid{
    display:grid;grid-template-columns:1fr;gap:var(--space-6xl);
    align-items:center;
  }
  .hero__tag{
    display:inline-flex;align-items:center;gap:var(--space-sm);
    padding:6px 12px;border-radius:var(--radius-full);
    background:var(--color-accent-light);
    color:var(--color-accent);
    font-size:var(--text-xs);font-weight:500;
    letter-spacing:.02em;
    margin-bottom:var(--space-2xl);
  }
  .hero__tag-dot{
    width:6px;height:6px;border-radius:50%;
    background:var(--color-accent);
    box-shadow:0 0 0 3px var(--color-accent-light);
    animation:pulse 2.4s ease-in-out infinite;
  }
  @keyframes pulse{0%,100%{opacity:1}50%{opacity:.5}}
  .hero__title{
    font-family:var(--font-display);
    font-weight:500;
    font-size:clamp(34px,6vw,56px);
    line-height:1.1;
    letter-spacing:-.02em;
    color:var(--color-encre-douce);
    margin:0 0 var(--space-2xl);
    text-wrap:balance;
  }
  .hero__subtitle{
    font-size:var(--text-md);
    line-height:1.6;
    color:var(--color-text-secondary);
    max-width:560px;
    margin:0 0 var(--space-4xl);
    text-wrap:pretty;
  }
  .hero__ctas{display:flex;flex-wrap:wrap;gap:var(--space-md)}

  .hero__metrics{
    display:grid;grid-template-columns:repeat(3,1fr);
    gap:var(--space-2xl);
    margin-top:var(--space-6xl);
    padding-top:var(--space-4xl);
    border-top:1px solid var(--color-border-light);
  }
  .metric__value{
    font-family:var(--font-display);
    font-size:var(--text-2xl);
    font-weight:500;
    color:var(--color-encre-douce);
    letter-spacing:-.01em;
  }
  .metric__label{
    font-size:var(--text-sm);
    color:var(--color-text-muted);
    margin-top:2px;
  }

  /* === MOCKUP CHAT (right hero) === */
  .mockup{
    position:relative;
    background:var(--color-surface);
    border-radius:24px;
    border:1px solid var(--color-border-light);
    box-shadow:var(--shadow-xl);
    padding:var(--space-2xl);
    max-width:440px;
    margin:0 auto;
    width:100%;
  }
  .mockup::before{
    content:"";
    position:absolute;inset:-40px -40px auto auto;
    width:280px;height:280px;
    background:radial-gradient(circle,var(--color-accent-light) 0%,transparent 70%);
    z-index:-1;border-radius:50%;
    filter:blur(20px);
  }
  .mockup__header{
    display:flex;align-items:center;justify-content:space-between;
    padding-bottom:var(--space-lg);
    border-bottom:1px solid var(--color-border-light);
    margin-bottom:var(--space-lg);
  }
  .mockup__title{
    font-family:var(--font-display);
    font-size:var(--text-md);font-weight:500;
  }
  .mockup__dots{display:flex;gap:5px}
  .mockup__dots i{width:8px;height:8px;border-radius:50%;background:var(--color-pierre-pale)}
  .msg{display:flex;gap:var(--space-md);margin-bottom:var(--space-lg);align-items:flex-end}
  .msg--user{flex-direction:row-reverse}
  .msg__avatar{
    width:32px;height:32px;border-radius:50%;
    background:var(--color-accent);
    display:grid;place-items:center;
    flex:none;
  }
  .msg__avatar svg{width:16px;height:16px;color:#fff}
  .msg--user .msg__avatar{background:var(--color-pierre-pale)}
  .msg--user .msg__avatar svg{color:var(--color-cendre-tiede)}
  .msg__bubble{
    background:var(--color-surface);
    border:1px solid var(--color-border-light);
    border-radius:var(--radius-xl);
    padding:12px 16px;
    font-size:var(--text-sm);line-height:1.55;
    max-width:80%;
    color:var(--color-text-primary);
  }
  .msg--ai .msg__bubble{border-top-left-radius:var(--space-xs)}
  .msg--user .msg__bubble{
    background:var(--color-argile-clair);
    border-color:transparent;
    border-top-right-radius:var(--space-xs);
  }
  .mockup__input{
    margin-top:var(--space-lg);
    display:flex;align-items:center;gap:var(--space-sm);
    background:var(--color-lin-calme);
    border-radius:30px;padding:6px 6px 6px 18px;
    border:1px solid var(--color-border-light);
  }
  .mockup__input-text{
    flex:1;font-size:var(--text-sm);color:var(--color-text-muted);
  }
  .mockup__input-btn{
    width:36px;height:36px;border-radius:50%;
    background:var(--color-accent);
    display:grid;place-items:center;
    flex:none;
    box-shadow:var(--shadow-accent);
  }
  .mockup__input-btn svg{width:16px;height:16px;color:#fff}

  /* === SECTIONS === */
  .section{padding:var(--space-7xl) 0}
  .section--tight{padding:var(--space-6xl) 0}
  .section__head{text-align:center;max-width:680px;margin:0 auto var(--space-6xl)}
  .eyebrow{
    display:inline-block;
    font-size:var(--text-xs);font-weight:600;
    text-transform:uppercase;letter-spacing:.12em;
    color:var(--color-accent);
    margin-bottom:var(--space-md);
  }
  .section__title{
    font-family:var(--font-display);
    font-weight:500;
    font-size:clamp(28px,4vw,42px);
    line-height:1.15;letter-spacing:-.015em;
    color:var(--color-encre-douce);
    margin:0 0 var(--space-lg);
    text-wrap:balance;
  }
  .section__subtitle{
    font-size:var(--text-md);line-height:1.6;
    color:var(--color-text-secondary);
    margin:0;text-wrap:pretty;
  }

  /* === DUAL ROLE === */
  .dual{
    display:grid;grid-template-columns:1fr;
    gap:var(--space-2xl);
  }
  .role-card{
    background:var(--color-surface);
    border:1px solid var(--color-border-light);
    border-radius:var(--radius-2xl);
    padding:var(--space-4xl);
    transition:border-color var(--transition-slow),box-shadow var(--transition-slow),transform var(--transition-slow);
  }
  .role-card:hover{
    border-color:var(--color-accent-light);
    box-shadow:var(--shadow-md);
    transform:translateY(-2px);
  }
  .role-card__icon{
    width:52px;height:52px;border-radius:var(--radius-lg);
    background:var(--color-accent-light);
    display:grid;place-items:center;
    margin-bottom:var(--space-2xl);
  }
  .role-card__icon svg{width:24px;height:24px;color:var(--color-accent)}
  .role-card--alt .role-card__icon{background:rgba(166,195,179,.18)}
  .role-card--alt .role-card__icon svg{color:#658a73}
  .role-card__title{
    font-family:var(--font-display);
    font-weight:500;
    font-size:var(--text-xl);
    margin:0 0 var(--space-md);
    letter-spacing:-.01em;
  }
  .role-card__desc{
    color:var(--color-text-secondary);
    line-height:1.6;
    margin:0 0 var(--space-2xl);
  }
  .tag-row{display:flex;flex-wrap:wrap;gap:var(--space-sm)}
  .tag{
    padding:5px 11px;
    background:var(--color-lin-calme);
    border:1px solid var(--color-border-light);
    border-radius:var(--radius-full);
    font-size:var(--text-xs);font-weight:500;
    color:var(--color-text-secondary);
  }

  /* === SHOWCASE FEATURES === */
  .feature{
    display:grid;grid-template-columns:1fr;gap:var(--space-5xl);
    padding:var(--space-7xl) 0;
    border-bottom:1px solid var(--color-border-light);
    align-items:center;
  }
  .feature:last-child{border-bottom:0}
  .feature__copy h3{
    font-family:var(--font-display);
    font-weight:500;font-size:clamp(24px,3.4vw,34px);
    line-height:1.2;letter-spacing:-.01em;
    margin:var(--space-md) 0 var(--space-lg);
    color:var(--color-encre-douce);
    text-wrap:balance;
  }
  .feature__copy p{
    color:var(--color-text-secondary);
    font-size:var(--text-md);line-height:1.6;
    margin:0 0 var(--space-2xl);
    text-wrap:pretty;
  }
  .feature__bullets{display:grid;gap:var(--space-md)}
  .feature__bullets li{
    display:flex;gap:var(--space-md);
    align-items:flex-start;
    font-size:var(--text-sm);
    color:var(--color-text-primary);
    line-height:1.5;
  }
  .feature__check{
    width:20px;height:20px;border-radius:var(--radius-sm);
    background:var(--color-accent-light);color:var(--color-accent);
    display:grid;place-items:center;flex:none;margin-top:1px;
  }
  .feature__check svg{width:12px;height:12px;stroke-width:2.5}

  /* visual side cards */
  .visual{
    background:var(--color-surface);
    border:1px solid var(--color-border-light);
    border-radius:var(--radius-2xl);
    padding:var(--space-3xl);
    box-shadow:var(--shadow-lg);
  }
  .visual__header{
    display:flex;align-items:center;justify-content:space-between;
    margin-bottom:var(--space-2xl);
  }
  .visual__title{
    font-family:var(--font-display);
    font-size:var(--text-md);font-weight:500;
  }
  .visual__pill{
    font-size:var(--text-xs);
    color:var(--color-accent);
    background:var(--color-accent-light);
    padding:4px 10px;border-radius:var(--radius-full);
    font-weight:500;
  }
  .v-action{
    margin-top:var(--space-lg);padding:var(--space-lg);
    background:var(--color-lin-calme);
    border-radius:var(--radius-lg);
    font-size:var(--text-sm);
    color:var(--color-text-primary);
    line-height:1.55;
    display:flex;gap:var(--space-md);align-items:flex-start;
  }
  .v-action__icon{
    width:22px;height:22px;border-radius:var(--radius-sm);
    background:var(--color-accent);color:#fff;
    display:grid;place-items:center;flex:none;margin-top:1px;
  }
  .v-action__icon svg{width:12px;height:12px;stroke-width:2.5}
  .v-action strong{font-weight:600}

  /* dashboard (feature 2) */
  .dashboard__stats{display:grid;grid-template-columns:repeat(3,1fr);gap:var(--space-md);margin-bottom:var(--space-lg)}
  .stat{
    background:var(--color-lin-calme);
    border-radius:var(--radius-md);
    padding:var(--space-lg);
  }
  .stat__label{font-size:var(--text-xs);color:var(--color-text-muted);margin-bottom:6px;text-transform:uppercase;letter-spacing:.05em}
  .stat__value{font-family:var(--font-display);font-size:var(--text-lg);font-weight:500;color:var(--color-encre-douce)}
  .dashboard__items{display:grid;gap:var(--space-sm)}
  .dash-item{
    display:flex;align-items:center;justify-content:space-between;
    padding:var(--space-md) var(--space-lg);
    border-radius:var(--radius-md);
    background:var(--color-lin-calme);
  }
  .dash-item__left{display:flex;align-items:center;gap:var(--space-md)}
  .dash-item__icon{
    width:32px;height:32px;border-radius:var(--radius-md);
    background:var(--color-accent-light);color:var(--color-accent);
    display:grid;place-items:center;flex:none;
  }
  .dash-item__icon svg{width:16px;height:16px}
  .dash-item__icon--alt{background:rgba(166,195,179,.22);color:#658a73}
  .dash-item__icon--warm{background:rgba(209,179,139,.25);color:#9a7740}
  .dash-item__icon--neutral{background:var(--color-pierre-pale);color:var(--color-cendre-tiede)}
  .dash-item__label{font-size:var(--text-sm);font-weight:500}
  .dash-item__count{font-size:var(--text-xs);color:var(--color-text-muted);font-weight:500}

  /* scout */
  .scout{display:grid;gap:var(--space-md)}
  .scout-card{
    background:var(--color-lin-calme);
    border:1px solid var(--color-border-light);
    border-radius:var(--radius-md);
    padding:var(--space-lg);
  }
  .scout-card__head{display:flex;justify-content:space-between;align-items:flex-start;gap:var(--space-md);margin-bottom:6px}
  .scout-card__role{font-size:var(--text-sm);font-weight:600;color:var(--color-encre-douce)}
  .scout-card__meta{font-size:var(--text-xs);color:var(--color-text-muted);margin-bottom:var(--space-sm)}
  .scout-card__bar{
    height:4px;background:var(--color-argile-clair);border-radius:var(--radius-full);
    overflow:hidden;margin-bottom:6px;
  }
  .scout-card__bar i{display:block;height:100%;background:var(--color-accent);border-radius:inherit}
  .scout-card__rel{display:flex;align-items:center;justify-content:space-between;font-size:var(--text-xs);font-weight:500}
  .scout-card__rel--high{color:var(--color-accent)}
  .scout-card__rel--mid{color:#658a73}
  .scout-card__rel--low{color:#9a7740}

  /* project (feature 4) */
  .project__progress{
    display:flex;justify-content:space-between;align-items:center;
    margin-bottom:var(--space-lg);
  }
  .project__progress-bar{
    flex:1;height:6px;background:var(--color-argile-clair);
    border-radius:var(--radius-full);overflow:hidden;
    margin:0 var(--space-md);
  }
  .project__progress-bar i{display:block;width:55%;height:100%;background:var(--color-accent);border-radius:inherit}
  .project__progress-num{font-size:var(--text-sm);font-weight:500;color:var(--color-text-secondary)}
  .project__steps{display:grid;gap:var(--space-sm)}
  .pstep{
    display:flex;align-items:center;gap:var(--space-md);
    padding:var(--space-md) var(--space-lg);
    background:var(--color-lin-calme);
    border-radius:var(--radius-md);
    font-size:var(--text-sm);
  }
  .pstep__dot{
    width:18px;height:18px;border-radius:50%;
    border:2px solid var(--color-pierre-pale);
    flex:none;background:var(--color-surface);
    position:relative;
  }
  .pstep--done .pstep__dot{background:var(--color-accent);border-color:var(--color-accent)}
  .pstep--done .pstep__dot::after{
    content:"";position:absolute;
    left:4px;top:1px;
    width:5px;height:8px;
    border:2px solid #fff;border-top:0;border-left:0;
    transform:rotate(45deg);
  }
  .pstep--current .pstep__dot{
    border-color:var(--color-accent);
    box-shadow:0 0 0 4px var(--color-accent-light);
  }
  .pstep__label{font-weight:500;color:var(--color-encre-douce)}
  .pstep--done .pstep__label{color:var(--color-text-muted);text-decoration:line-through;text-decoration-color:var(--color-pierre-pale)}

  /* === PHILOSOPHY === */
  .spheres{
    display:grid;grid-template-columns:1fr;gap:var(--space-2xl);
  }
  .sphere{
    background:var(--color-surface);
    border:1px solid var(--color-border-light);
    border-radius:var(--radius-2xl);
    padding:var(--space-4xl) var(--space-3xl);
    text-align:center;
    transition:border-color var(--transition-slow),transform var(--transition-slow),box-shadow var(--transition-slow);
  }
  .sphere:hover{transform:translateY(-3px);border-color:var(--color-accent-light);box-shadow:var(--shadow-md)}
  .sphere__icon{
    width:64px;height:64px;border-radius:var(--radius-full);
    margin:0 auto var(--space-lg);
    display:grid;place-items:center;
    background:var(--color-accent-light);color:var(--color-accent);
  }
  .sphere--alt .sphere__icon{background:rgba(166,195,179,.22);color:#658a73}
  .sphere--warm .sphere__icon{background:rgba(209,179,139,.25);color:#9a7740}
  .sphere__icon svg{width:28px;height:28px}
  .sphere__title{
    font-family:var(--font-display);
    font-size:var(--text-xl);font-weight:500;
    margin:0 0 var(--space-sm);letter-spacing:-.01em;
  }
  .sphere__desc{
    color:var(--color-text-secondary);
    margin:0 0 var(--space-lg);font-size:var(--text-sm);line-height:1.6;
  }
  .sphere .tag-row{justify-content:center}

  /* === HOW IT WORKS === */
  .how{display:grid;grid-template-columns:1fr;gap:var(--space-3xl);position:relative}
  .step{position:relative;display:flex;flex-direction:column;align-items:flex-start}
  .step__num{
    width:40px;height:40px;border-radius:var(--radius-full);
    background:var(--color-accent);
    color:#fff;
    display:grid;place-items:center;
    font-family:var(--font-display);font-size:var(--text-md);font-weight:500;
    margin-bottom:var(--space-lg);
    box-shadow:var(--shadow-accent);
  }
  .step__title{
    font-family:var(--font-display);
    font-size:var(--text-md);font-weight:500;
    margin:0 0 var(--space-sm);
  }
  .step__desc{
    font-size:var(--text-sm);line-height:1.6;
    color:var(--color-text-secondary);margin:0;
  }

  /* === TRUST === */
  .trust{display:grid;grid-template-columns:1fr;gap:var(--space-2xl)}
  .trust-card{
    background:var(--color-surface);
    border:1px solid var(--color-border-light);
    border-radius:var(--radius-2xl);
    padding:var(--space-3xl);
  }
  .trust-card__icon{
    width:44px;height:44px;border-radius:var(--radius-md);
    background:var(--color-accent-light);color:var(--color-accent);
    display:grid;place-items:center;
    margin-bottom:var(--space-lg);
  }
  .trust-card__icon svg{width:20px;height:20px}
  .trust-card__title{
    font-family:var(--font-display);
    font-size:var(--text-md);font-weight:500;
    margin:0 0 var(--space-sm);
  }
  .trust-card__desc{
    color:var(--color-text-secondary);
    line-height:1.6;font-size:var(--text-sm);margin:0;
  }

  /* === MULTI === */
  .multi{
    background:var(--color-surface);
    border:1px solid var(--color-border-light);
    border-radius:var(--radius-2xl);
    padding:var(--space-5xl) var(--space-3xl);
    text-align:center;
  }
  .lang-grid{
    display:grid;
    grid-template-columns:repeat(auto-fill,minmax(110px,1fr));
    gap:var(--space-sm);
    max-width:780px;margin:var(--space-3xl) auto 0;
  }
  .lang-chip{
    padding:8px 12px;background:var(--color-lin-calme);
    border-radius:var(--radius-md);
    font-size:var(--text-sm);color:var(--color-text-secondary);
    font-weight:500;
    transition:background var(--transition-normal),color var(--transition-normal);
  }
  .lang-chip:hover{background:var(--color-argile-clair);color:var(--color-text-primary)}

  /* === FINAL CTA === */
  .final-cta{
    background:var(--color-encre-douce);
    color:#fff;
    border-radius:var(--radius-2xl);
    padding:var(--space-7xl) var(--space-3xl);
    text-align:center;
    position:relative;overflow:hidden;
  }
  .final-cta::before{
    content:"";position:absolute;
    top:-100px;right:-100px;width:400px;height:400px;
    background:radial-gradient(circle,rgba(143,168,155,.25),transparent 70%);
    border-radius:50%;
    pointer-events:none;
  }
  .final-cta::after{
    content:"";position:absolute;
    bottom:-100px;left:-100px;width:400px;height:400px;
    background:radial-gradient(circle,rgba(166,195,179,.18),transparent 70%);
    border-radius:50%;
    pointer-events:none;
  }
  .final-cta__inner{position:relative;z-index:1;max-width:640px;margin:0 auto}
  .final-cta__title{
    font-family:var(--font-display);
    font-weight:500;
    font-size:clamp(28px,4vw,44px);
    line-height:1.15;letter-spacing:-.01em;
    margin:0 0 var(--space-lg);
    text-wrap:balance;
  }
  .final-cta__subtitle{
    color:rgba(255,255,255,.75);
    font-size:var(--text-md);line-height:1.6;
    margin:0 0 var(--space-3xl);
    text-wrap:pretty;
  }
  .final-cta .btn--primary{background:var(--color-accent);color:#fff}
  .final-cta .btn--primary:hover{background:var(--color-accent-hover)}

  /* === FOOTER === */
  .footer{
    padding:var(--space-6xl) 0 var(--space-3xl);
    border-top:1px solid var(--color-border-light);
    margin-top:var(--space-6xl);
  }
  .footer__top{
    display:grid;
    grid-template-columns:1fr;
    gap:var(--space-4xl);
    margin-bottom:var(--space-4xl);
  }
  .footer__brand .brand{margin-bottom:var(--space-md)}
  .footer__tagline{
    font-size:var(--text-sm);
    color:var(--color-text-muted);
    max-width:300px;line-height:1.6;
  }
  .footer__col h4{
    font-size:var(--text-xs);font-weight:600;
    text-transform:uppercase;letter-spacing:.1em;
    color:var(--color-text-muted);
    margin:0 0 var(--space-lg);
  }
  .footer__col ul{display:grid;gap:var(--space-md)}
  .footer__col a{
    font-size:var(--text-sm);
    color:var(--color-text-secondary);
    transition:color var(--transition-normal);
  }
  .footer__col a:hover{color:var(--color-accent)}
  .footer__bottom{
    display:flex;flex-wrap:wrap;justify-content:space-between;align-items:center;
    gap:var(--space-md);
    padding-top:var(--space-2xl);
    border-top:1px solid var(--color-border-light);
    font-size:var(--text-xs);color:var(--color-text-muted);
  }

  /* === ANIM ON SCROLL === */
  .reveal{opacity:0;transform:translateY(16px);transition:opacity .6s ease,transform .6s ease}
  .reveal.is-in{opacity:1;transform:translateY(0)}

  @media (prefers-reduced-motion:reduce){
    *{animation:none!important;transition:none!important}
    .reveal{opacity:1;transform:none}
  }

  /* === MEDIA === */
  @media (min-width:720px){
    .dual{grid-template-columns:1fr 1fr}
    .spheres{grid-template-columns:repeat(3,1fr)}
    .how{grid-template-columns:repeat(2,1fr);gap:var(--space-4xl)}
    .trust{grid-template-columns:repeat(3,1fr)}
    .footer__top{grid-template-columns:2fr 1fr 1fr 1fr}
    .feature{grid-template-columns:1fr 1fr}
    .feature--reverse .feature__copy{order:2}
  }
  @media (min-width:960px){
    .nav__links{display:flex}
    .hero__grid{grid-template-columns:1.05fr 1fr;gap:var(--space-7xl)}
    .how{grid-template-columns:repeat(4,1fr)}
  }
